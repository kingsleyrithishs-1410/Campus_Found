# run.py creates a .env for you on first start. Use this file as a reference.
# Never share or commit your real .env file.

# local = your computer / campus network over http (start scripts)
# production = behind HTTPS on a server
FLASK_CONFIG=local

# Long random string: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# Leave empty for SQLite (instance/lost_found.db). MySQL example:
# DATABASE_URL=mysql+pymysql://lostfound:password@localhost/lost_found?charset=utf8mb4
DATABASE_URL=

# Only these email domains can register (sub-domains are included).
# Leave empty (ALLOWED_EMAIL_DOMAINS=) to allow any email address.
ALLOWED_EMAIL_DOMAINS=

# Require users to confirm their email before logging in (needs MAIL_* below).
EMAIL_VERIFICATION_REQUIRED=false
MAIL_SERVER=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_USE_TLS=true
MAIL_FROM=

# Campus. Defaults come from campus_data.py; admins can also change these
# in Admin -> Settings.
# CAMPUS_NAME=campusfound
# CAMPUS_LAT=12.8003
# CAMPUS_LNG=80.2260
# CAMPUS_ZOOM=17
DISPLAY_TIMEZONE=Asia/Kolkata

# Optional: create the first admin automatically instead of using the setup page.
# ADMIN_NAME=
# ADMIN_EMAIL=
# ADMIN_PASSWORD=

# Uploaded photos (outside the code folder is best on a server).
# UPLOAD_ROOT=

# Turn on when the site is served over HTTPS:
SESSION_COOKIE_SECURE=false
RATELIMIT_ENABLED=true
